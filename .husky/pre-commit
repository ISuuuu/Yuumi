# 记录本次提交已暂存的文件（-z/-0 处理含空格/换行文件名）
git diff --cached --name-only -z --diff-filter=ACMR > /tmp/yuumi-staged

# 仅在暂存区包含 Rust 文件时执行格式化，避免提交文档或配置时污染工作区
if [ -s /tmp/yuumi-staged ] && tr '\0' '\n' < /tmp/yuumi-staged | grep -q '\.rs$'; then
  pnpm run format
  # 仅把原本已暂存的文件中被 format 改动过的部分重新暂存
  xargs -0 -r git add -- < /tmp/yuumi-staged
fi
rm -f /tmp/yuumi-staged
